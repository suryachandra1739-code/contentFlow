{
  "name": "ContentFlow — Social Publisher",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "social-publish",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-trigger",
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [250, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "condition-instagram",
              "leftValue": "={{ $json.body.platforms.instagram }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "check-instagram",
      "name": "Instagram Enabled?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [500, 100]
    },
    {
      "parameters": {
        "conditions": {
          "conditions": [
            {
              "leftValue": "={{ $json.body.platforms.facebook }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "check-facebook",
      "name": "Facebook Enabled?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [500, 300]
    },
    {
      "parameters": {
        "conditions": {
          "conditions": [
            {
              "leftValue": "={{ $json.body.platforms.twitter }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "check-twitter",
      "name": "Twitter Enabled?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [500, 500]
    },
    {
      "parameters": {
        "conditions": {
          "conditions": [
            {
              "leftValue": "={{ $json.body.platforms.linkedin }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "check-linkedin",
      "name": "LinkedIn Enabled?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [500, 700]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://graph.facebook.com/v19.0/{{YOUR_INSTAGRAM_BUSINESS_ACCOUNT_ID}}/media",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            { "name": "image_url", "value": "={{ $json.body.image_url }}" },
            { "name": "caption", "value": "={{ $json.body.caption + '\\n\\n' + $json.body.hashtags }}" },
            { "name": "access_token", "value": "={{$credentials.facebookGraphApi.accessToken}}" }
          ]
        }
      },
      "id": "post-instagram-media",
      "name": "Create Instagram Media",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [750, 50],
      "notes": "Step 1: Create media container. Step 2 (next node) publishes it."
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v19.0/{{YOUR_INSTAGRAM_BUSINESS_ACCOUNT_ID}}/media_publish",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            { "name": "creation_id", "value": "={{ $json.id }}" },
            { "name": "access_token", "value": "={{$credentials.facebookGraphApi.accessToken}}" }
          ]
        }
      },
      "id": "publish-instagram",
      "name": "Publish Instagram",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [1000, 50]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v19.0/{{YOUR_PAGE_ID}}/feed",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            { "name": "message", "value": "={{ $json.body.caption + '\\n\\n' + $json.body.hashtags }}" },
            { "name": "link", "value": "={{ $json.body.image_url }}" },
            { "name": "access_token", "value": "={{$credentials.facebookGraphApi.accessToken}}" }
          ]
        }
      },
      "id": "post-facebook",
      "name": "Post to Facebook",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [750, 300]
    },
    {
      "parameters": {
        "text": "={{ $json.body.caption + '\\n\\n' + $json.body.hashtags }}",
        "additionalFields": {}
      },
      "id": "post-twitter",
      "name": "Post to Twitter/X",
      "type": "n8n-nodes-base.twitter",
      "typeVersion": 2,
      "position": [750, 500],
      "credentials": {
        "twitterOAuth2Api": {
          "id": "CONFIGURE_ME",
          "name": "Twitter OAuth2"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.linkedin.com/v2/ugcPosts",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "=Bearer {{YOUR_LINKEDIN_ACCESS_TOKEN}}" },
            { "name": "X-Restli-Protocol-Version", "value": "2.0.0" }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "body",
              "value": "={\"author\":\"urn:li:person:{{YOUR_LINKEDIN_PERSON_ID}}\",\"lifecycleState\":\"PUBLISHED\",\"specificContent\":{\"com.linkedin.ugc.ShareContent\":{\"shareCommentary\":{\"text\":\"{{ $json.body.caption + '\\n\\n' + $json.body.hashtags }}\"},\"shareMediaCategory\":\"NONE\"}},\"visibility\":{\"com.linkedin.ugc.MemberNetworkVisibility\":\"PUBLIC\"}}"
            }
          ]
        }
      },
      "id": "post-linkedin",
      "name": "Post to LinkedIn",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [750, 700]
    },
    {
      "parameters": {
        "options": {},
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ success: true, message: 'Published to all selected platforms', timestamp: new Date().toISOString() }) }}"
      },
      "id": "respond-success",
      "name": "Respond Success",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1200, 400]
    }
  ],
  "connections": {
    "Webhook Trigger": {
      "main": [
        [
          { "node": "Instagram Enabled?", "type": "main", "index": 0 },
          { "node": "Facebook Enabled?", "type": "main", "index": 0 },
          { "node": "Twitter Enabled?", "type": "main", "index": 0 },
          { "node": "LinkedIn Enabled?", "type": "main", "index": 0 }
        ]
