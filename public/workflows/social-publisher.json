      ]
    },
    "Publish Instagram": {
      "main": [
        [{ "node": "Respond Success", "type": "main", "index": 0 }]
      ]
    },
    "Facebook Enabled?": {
      "main": [
        [{ "node": "Post to Facebook", "type": "main", "index": 0 }],
        []
      ]
    },
    "Post to Facebook": {
      "main": [
        [{ "node": "Respond Success", "type": "main", "index": 0 }]
      ]
    },
    "Twitter Enabled?": {
      "main": [
        [{ "node": "Post to Twitter/X", "type": "main", "index": 0 }],
        []
      ]
    },
    "Post to Twitter/X": {
      "main": [
        [{ "node": "Respond Success", "type": "main", "index": 0 }]
      ]
    },
    "LinkedIn Enabled?": {
      "main": [
        [{ "node": "Post to LinkedIn", "type": "main", "index": 0 }],
        []
      ]
    },
    "Post to LinkedIn": {
      "main": [
        [{ "node": "Respond Success", "type": "main", "index": 0 }]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "meta": {
    "templateCredsSetupCompleted": false,
    "instanceId": "contentflow-social-publisher"
  },
  "tags": [
    { "name": "social-media" },
    { "name": "contentflow" },
    { "name": "automation" }
  ]
